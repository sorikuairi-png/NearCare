---
import { Image } from "astro:assets";
import heroPortrait from "../assets/hero-support-worker.jpg";

/**
 * Homepage hero.
 *
 * Two things carry the page's identity here:
 *  - the portrait sits in a map-pin clip-path (#pinClip, defined in Base),
 *    literalising "Near"Care rather than using a generic photo shape;
 *  - the concentric "proximity ping" rings behind it.
 *
 * The rings play once on arrival (finished by 4.4s — see theme.css for the
 * WCAG 2.2.2 reasoning) and afterwards only replay when the visitor touches
 * the postcode search, which is the action the motif stands for.
 */
const popularNeeds = ["Personal Care", "Community Access", "Capacity Building"];
---

<section class="relative hero-surface grain overflow-hidden">
	<div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-10">
		<div class="grid lg:grid-cols-2 gap-12 items-center pt-16 pb-20">
			<div class="reveal">
				<div class="relative inline-block">
					<span aria-hidden="true" class="absolute -inset-3 bg-lime-400/25 blur-xl rounded-full -z-10"></span>
					<span class="badge-free inline-flex items-center gap-2 text-[13px] font-bold text-lime-300 tracking-wide rounded-full px-4 py-1.5">
						<span class="relative w-1.5 h-1.5 rounded-full bg-lime-400">
							<span class="dot-ping" aria-hidden="true"></span>
						</span>
						Free For Families, Always
					</span>
				</div>

				<h1 class="font-display text-white text-[46px] sm:text-[62px] leading-[1.0] font-semibold mt-6">Find a support worker your family can <br class="hidden sm:block" /><span class="italic font-normal text-lime-400">trust</span><span class="text-lime-400">.</span></h1>

				<p class="text-white/65 text-[17px] leading-relaxed mt-6 max-w-md">
					Search verified independent support workers in your local area — checked credentials, real experience, no swiping. We help you connect; you decide who's right for your family.
				</p>

				<form
					id="heroSearch"
					class="search-field mt-9 flex items-center gap-2 bg-white rounded-full p-2 pl-5 max-w-md shadow-float"
					onsubmit="return false;"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c8f8b" stroke-width="2" class="shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
					<input
						type="text"
						placeholder="Postcode or Suburb…"
						aria-label="Postcode or suburb"
						class="w-full bg-transparent text-ink-900 placeholder:text-ink-400 text-[15px] outline-none"
					/>
					<button type="submit" class="btn-lime shrink-0 bg-lime-400 text-green-900 text-sm font-semibold rounded-full px-5 py-3">Search Workers</button>
				</form>

				<div class="flex flex-wrap items-center gap-2 mt-6">
					<span class="text-white/40 text-[13px] mr-1">Popular:</span>
					{
						popularNeeds.map((need) => (
							<a href="#" class="need-chip text-white/80 text-[13px] font-medium border border-white/15 rounded-full px-3.5 py-1.5">
								{need}
							</a>
						))
					}
				</div>
			</div>

			<div class="relative reveal" style="transition-delay: 120ms;">
				<div class="relative w-full max-w-md mx-auto aspect-square">
					<div id="heroPing" class="ping-rings" aria-hidden="true"><span></span><span></span><span></span></div>
					<Image
						src={heroPortrait}
						alt="Independent support worker smiling"
						widths={[400, 640, 900]}
						sizes="(min-width: 1024px) 28rem, 90vw"
						loading="eager"
						fetchpriority="high"
						class="pin-mask relative z-10 w-full h-full object-cover"
					/>
					<div class="absolute -bottom-4 -right-2 sm:right-6 float-slow z-20">
						<div class="flex items-center gap-3 bg-white rounded-2xl pl-3 pr-5 py-3 shadow-float">
							<span class="grid place-items-center w-10 h-10 rounded-xl bg-lime-300">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2" aria-hidden="true"><path d="M12 2l7 3v6c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V5z"/><path d="M9 12l2 2 4-4"/></svg>
							</span>
							<div class="leading-tight">
								<p class="font-display font-bold text-ink-900 text-[15px]">180+</p>
								<p class="text-ink-400 text-[12px]">Verified Support Workers</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Replay the proximity ping when the visitor engages the postcode search.
	// This is user-initiated, so it sits outside WCAG 2.2.2's auto-playing
	// motion rule — and it makes the motif mean something: you search, it pings.
	const rings = document.getElementById("heroPing");
	const search = document.getElementById("heroSearch");
	const stillPrefers = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	let cooling = false;
	function replay() {
		if (!rings || cooling || stillPrefers()) return;
		cooling = true;
		// Clearing the animation and forcing a reflow is what rewinds it;
		// re-asserting the same animation-name on a finished animation is a no-op.
		rings.classList.add("reset");
		void rings.offsetWidth;
		rings.classList.remove("reset");
		// The full staggered sequence runs 4.4s; don't stack replays on top.
		window.setTimeout(() => {
			cooling = false;
		}, 4400);
	}

	search?.addEventListener("focusin", replay);
	search?.addEventListener("submit", replay);
</script>
