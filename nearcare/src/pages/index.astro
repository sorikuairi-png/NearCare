---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import SectionEyebrow from "../components/SectionEyebrow.astro";
import JourneySteps from "../components/JourneySteps.astro";
import SpecialisationGrid from "../components/SpecialisationGrid.astro";
import GuideCard from "../components/GuideCard.astro";
import familyPortrait from "../assets/family-laptop.jpg";

/**
 * Placeholder social proof, carried over from the locked design reference.
 * Not yet backed by worker_profiles — kept in one place so there's a single
 * spot to swap when search and counts are wired to real data.
 */
const activeWorkers = "180+";
const avatars = [
	{ initial: "A", class: "bg-green-900 text-white" },
	{ initial: "B", class: "bg-clay-500 text-white" },
	{ initial: "C", class: "bg-lime-400 text-green-900" },
];

const guides = [
	{
		title: "Self-Managed vs Plan-Managed: What It Means for You",
		byline: "NearCare",
		date: "Apr 27, 2026",
		tone: "clay" as const,
	},
	{
		title: "What NDIS Worker Screening Actually Checks",
		byline: "NearCare",
		date: "Apr 19, 2026",
		tone: "forest" as const,
	},
];
---

<Base
	title="NearCare — Find A Trusted Independent Support Worker Near You"
	description="Search verified independent support workers (ISWs) in your local area. Free for families. Discovery only — we never employ workers, handle payments, or supervise care."
>
	<Hero />
	<TrustStrip />

	<!-- ============ WHY NEARCARE ============ -->
	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 grid lg:grid-cols-2 gap-16 items-center">
			<div class="reveal">
				<SectionEyebrow icon="star" label="How It Works" />
				<h2 class="font-display text-ink-900 text-[36px] sm:text-[42px] font-semibold leading-[1.08] mt-4">
					Search, compare, connect.
				</h2>
				<p class="text-ink-600 mt-5 max-w-md">
					No swiping, no cold messaging. Describe the support you need, search your local area, and follow one thread from first search to someone in your home you trust.
				</p>

				<JourneySteps />
			</div>

			<div class="relative reveal" style="transition-delay:100ms;">
				<div class="relative w-full max-w-sm mx-auto aspect-square">
					<Image
						src={familyPortrait}
						alt="Family reviewing a support worker's profile on a laptop"
						widths={[320, 480, 720]}
						sizes="(min-width: 1024px) 24rem, 80vw"
						loading="lazy"
						class="blob-mask w-full h-full object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- ============ SEARCH SNAPSHOT + RESOURCES ============ -->
	<section class="bg-cream-50">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 grid lg:grid-cols-2 gap-8">
			<!-- Support types card -->
			<div class="reveal bg-white rounded-[28px] p-8 sm:p-10 shadow-card">
				<SectionEyebrow icon="pin" label="Available Near You" />
				<h2 class="font-display text-ink-900 text-[27px] font-semibold mt-3">
					Support workers by specialisation
				</h2>

				<SpecialisationGrid />

				<div class="flex items-center gap-3 mt-8 pt-6 border-t border-mist-200">
					<div class="flex -space-x-3" aria-hidden="true">
						{
							avatars.map((avatar) => (
								<span
									class:list={[
										"grid place-items-center w-9 h-9 rounded-full border-2 border-white font-display font-semibold text-[13px]",
										avatar.class,
									]}
								>
									{avatar.initial}
								</span>
							))
						}
					</div>
					<p class="text-[14px] text-ink-600">
						<span class="font-display font-bold text-ink-900">{activeWorkers}</span> verified support workers active this month
					</p>
				</div>
			</div>

			<!-- Resources card -->
			<div class="reveal bg-white rounded-[28px] p-8 sm:p-10 shadow-card" style="transition-delay:100ms;">
				<SectionEyebrow icon="shield" label="Resources & Safety" />
				<h2 class="font-display text-ink-900 text-[27px] font-semibold mt-3">Know before you search</h2>

				<div class="grid sm:grid-cols-2 gap-5 mt-8">
					{guides.map((guide) => <GuideCard {...guide} />)}
				</div>
			</div>
		</div>
	</section>
</Base>
