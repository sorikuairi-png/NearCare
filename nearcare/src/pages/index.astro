---
import Base from "../layouts/Base.astro";
---

<Base
	title="NearCare — Find A Trusted Independent Support Worker Near You"
	description="Search verified independent support workers (ISWs) in your local area. Free for families. Discovery only — we never employ workers, handle payments, or supervise care."
>
	<!-- ============ HERO ============ -->
	<section class="relative hero-surface grain overflow-hidden">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-10">
			<div class="grid lg:grid-cols-2 gap-12 items-center pt-16 pb-20">
				<div class="reveal">
					<div class="relative inline-block">
						<span aria-hidden="true" class="absolute -inset-3 bg-lime-400/25 blur-xl rounded-full -z-10"></span>
						<span class="badge-free inline-flex items-center gap-2 text-[13px] font-bold text-lime-300 tracking-wide rounded-full px-4 py-1.5">
							<span class="relative w-1.5 h-1.5 rounded-full bg-lime-400">
								<span class="dot-ping" aria-hidden="true"></span>
							</span>
							Free For Families, Always
						</span>
					</div>

					<h1 class="font-display text-white text-[42px] sm:text-[52px] leading-[1.06] font-bold mt-6">
						Find A Support Worker Your Family Can <span class="text-lime-400">Trust</span>
					</h1>

					<p class="text-white/65 text-[17px] leading-relaxed mt-6 max-w-md">
						Search verified independent support workers in your local area — checked credentials, real experience, no swiping. We help you connect; you decide who's right for your family.
					</p>

					<form class="search-field mt-8 flex items-center gap-2 bg-white rounded-full p-2 pl-5 max-w-md shadow-float" onsubmit="return false;">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c8f8b" stroke-width="2" class="shrink-0"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
						<input type="text" placeholder="Postcode or Suburb…" aria-label="Postcode or suburb" class="w-full bg-transparent text-ink-900 placeholder:text-ink-400 text-[15px] outline-none">
						<button type="submit" class="btn-lime shrink-0 bg-lime-400 text-green-900 text-sm font-semibold rounded-full px-5 py-3">Search Workers</button>
					</form>

					<p class="text-white/50 text-[13px] mt-5">Popular needs: <a href="#" class="nav-link text-white/80">Personal Care</a>, <a href="#" class="nav-link text-white/80">Community Access</a>, <a href="#" class="nav-link text-white/80">Capacity Building</a></p>
				</div>

				<div class="relative reveal" style="transition-delay: 120ms;">
					<div class="relative w-full max-w-md mx-auto aspect-square">
						<img src="/images/hero-support-worker.jpg" alt="Independent support worker smiling" class="clover-mask w-full h-full object-cover">
						<div class="absolute -bottom-4 -right-2 sm:right-6 float-slow">
							<div class="flex items-center gap-3 bg-white rounded-2xl pl-3 pr-5 py-3 shadow-float">
								<span class="grid place-items-center w-10 h-10 rounded-xl bg-lime-300">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M12 2l7 3v6c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V5z"/><path d="M9 12l2 2 4-4"/></svg>
								</span>
								<div class="leading-tight">
									<p class="font-display font-bold text-ink-900 text-[15px]">180+</p>
									<p class="text-ink-400 text-[12px]">Verified Support Workers</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Trust / compliance strip -->
		<div class="relative z-10 border-t border-white/10 bg-green-950/40">
			<div class="max-w-7xl mx-auto px-6 lg:px-10 py-8 flex flex-col items-center gap-4">
				<p class="text-white/40 text-[12px] font-semibold uppercase tracking-wide">Every profile is document-checked against</p>
				<div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-4">
					<span class="font-display font-semibold text-white/50 text-[15px] tracking-wide">Working With Children Check</span>
					<span class="font-display font-semibold text-white/50 text-[15px] tracking-wide">NDIS Worker Screening</span>
					<span class="font-display font-semibold text-white/50 text-[15px] tracking-wide">Police Check</span>
					<span class="font-display font-semibold text-white/50 text-[15px] tracking-wide">Public Liability Insurance</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ============ HOW IT WORKS ============ -->
	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 grid lg:grid-cols-2 gap-16 items-center">

			<div class="reveal">
				<span class="inline-flex items-center gap-2 text-[13px] font-bold text-green-800 uppercase tracking-wide">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2.5"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2L12 16.4 5.7 21l2.3-7.2-6-4.6h7.6z"/></svg>
					How It Works
				</span>
				<h2 class="font-display text-ink-900 text-[34px] sm:text-[40px] font-bold leading-[1.1] mt-4">Search, Compare, Connect</h2>
				<p class="text-ink-600 mt-5 max-w-md">
					No swiping, no cold messaging. Describe the support you need, search your local area, and get a ranked list of independent support workers — with a fit indicator showing exactly why each one appears where they do.
				</p>

				<div class="grid sm:grid-cols-2 gap-x-8 gap-y-8 mt-10">
					<div class="reveal">
						<span class="grid place-items-center w-11 h-11 rounded-xl bg-mist-100">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M3 17l6-6 4 4 8-8M21 7v6h-6"/></svg>
						</span>
						<h3 class="font-display font-semibold text-ink-900 mt-4">Fit Indicator</h3>
						<p class="text-ink-400 text-[14px] mt-1.5">See exactly why a worker is ranked where they are — never a black box.</p>
					</div>
					<div class="reveal" style="transition-delay:80ms;">
						<span class="grid place-items-center w-11 h-11 rounded-xl bg-mist-100">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
						</span>
						<h3 class="font-display font-semibold text-ink-900 mt-4">Verified Credentials</h3>
						<p class="text-ink-400 text-[14px] mt-1.5">Every WWCC, NDIS Worker Screening, and police check is reviewed — never just self-reported.</p>
					</div>
					<div class="reveal" style="transition-delay:160ms;">
						<span class="grid place-items-center w-11 h-11 rounded-xl bg-mist-100">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20M4 4.5A2.5 2.5 0 016.5 2H20v20H6.5A2.5 2.5 0 014 19.5z"/></svg>
						</span>
						<h3 class="font-display font-semibold text-ink-900 mt-4">In-App Messaging</h3>
						<p class="text-ink-400 text-[14px] mt-1.5">Sort out details safely before you ever share a phone number.</p>
					</div>
					<div class="reveal" style="transition-delay:240ms;">
						<span class="grid place-items-center w-11 h-11 rounded-xl bg-mist-100">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M12 2l7 3v6c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V5z"/></svg>
						</span>
						<h3 class="font-display font-semibold text-ink-900 mt-4">Loop In Your Support Coordinator</h3>
						<p class="text-ink-400 text-[14px] mt-1.5">Found the right fit? We'll recommend you loop in your LAC or Support Coordinator so they can help formalise things.</p>
					</div>
				</div>
			</div>

			<div class="relative reveal" style="transition-delay:100ms;">
				<div class="relative w-full max-w-sm mx-auto aspect-square">
					<img src="/images/family-laptop.jpg" alt="Family reviewing a support worker's profile on a laptop" class="blob-mask w-full h-full object-cover">
				</div>
			</div>
		</div>
	</section>

	<!-- ============ SEARCH SNAPSHOT + RESOURCES ============ -->
	<section class="bg-mist-100">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 grid lg:grid-cols-2 gap-8">

			<!-- Support types card -->
			<div class="reveal bg-white rounded-[28px] p-8 sm:p-10 shadow-card">
				<span class="inline-flex items-center gap-2 text-[13px] font-bold text-green-800 uppercase tracking-wide">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2.5"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
					Available Near You
				</span>
				<h2 class="font-display text-ink-900 text-[26px] font-bold mt-3">Support Workers By Specialisation</h2>

				<div class="grid grid-cols-2 gap-4 mt-8">
					<div tabindex="0" class="tile-card bg-mist-100 rounded-2xl p-5">
						<span class="grid place-items-center w-9 h-9 rounded-lg bg-white">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
						</span>
						<p class="font-display font-semibold text-ink-900 mt-3 text-[15px]">Personal Care</p>
						<p class="text-ink-400 text-[13px]">63 Available Nearby</p>
					</div>
					<div tabindex="0" class="tile-card bg-lime-400 rounded-2xl p-5">
						<span class="grid place-items-center w-9 h-9 rounded-lg bg-white/70">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M3 11l18-8-8 18-2-8-8-2z"/></svg>
						</span>
						<p class="font-display font-semibold text-green-900 mt-3 text-[15px]">Community Access</p>
						<p class="text-green-900/70 text-[13px]">42 Available Nearby</p>
					</div>
					<div tabindex="0" class="tile-card bg-mist-100 rounded-2xl p-5">
						<span class="grid place-items-center w-9 h-9 rounded-lg bg-white">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M3 9l9-6 9 6-9 6-9-6z"/><path d="M3 9v6l9 6 9-6V9"/></svg>
						</span>
						<p class="font-display font-semibold text-ink-900 mt-3 text-[15px]">Domestic Assistance</p>
						<p class="text-ink-400 text-[13px]">37 Available Nearby</p>
					</div>
					<div tabindex="0" class="tile-card bg-mist-100 rounded-2xl p-5">
						<span class="grid place-items-center w-9 h-9 rounded-lg bg-white">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
						</span>
						<p class="font-display font-semibold text-ink-900 mt-3 text-[15px]">Behaviour Support</p>
						<p class="text-ink-400 text-[13px]">18 Available Nearby</p>
					</div>
				</div>

				<div class="flex items-center gap-3 mt-8 pt-6 border-t border-mist-200">
					<div class="flex -space-x-3">
						<img src="https://placehold.co/40x40/004743/ffffff?text=A" class="w-9 h-9 rounded-full border-2 border-white object-cover" alt="">
						<img src="https://placehold.co/40x40/0a5850/ffffff?text=B" class="w-9 h-9 rounded-full border-2 border-white object-cover" alt="">
						<img src="https://placehold.co/40x40/c2e2a1/004743?text=C" class="w-9 h-9 rounded-full border-2 border-white object-cover" alt="">
					</div>
					<p class="text-[14px] text-ink-600"><span class="font-display font-bold text-ink-900">180+</span> verified support workers active this month</p>
				</div>
			</div>

			<!-- Resources card -->
			<div class="reveal bg-white rounded-[28px] p-8 sm:p-10 shadow-card" style="transition-delay:100ms;">
				<span class="inline-flex items-center gap-2 text-[13px] font-bold text-green-800 uppercase tracking-wide">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#004743" stroke-width="2.5"><path d="M12 2l7 3v6c0 5-3.4 8.7-7 10-3.6-1.3-7-5-7-10V5z"/></svg>
					Resources &amp; Safety
				</span>
				<h2 class="font-display text-ink-900 text-[26px] font-bold mt-3">Know Before You Search</h2>

				<div class="grid sm:grid-cols-2 gap-5 mt-8">
					<a href="#" class="blog-card block group focus-visible:outline focus-visible:outline-2 focus-visible:outline-green-900 rounded-2xl">
						<div class="rounded-2xl overflow-hidden aspect-[4/3]">
							<img src="https://placehold.co/400x300/9fb8b2/013531?text=Guide" alt="" class="w-full h-full object-cover">
						</div>
						<p class="font-display font-semibold text-ink-900 mt-4 text-[15px] leading-snug">Self-Managed vs Plan-Managed: What It Means for You</p>
						<p class="text-ink-400 text-[13px] mt-2">By NearCare · Apr 27, 2026</p>
					</a>
					<a href="#" class="blog-card block group focus-visible:outline focus-visible:outline-2 focus-visible:outline-green-900 rounded-2xl">
						<div class="rounded-2xl overflow-hidden aspect-[4/3]">
							<img src="https://placehold.co/400x300/cdd8d2/0b201d?text=Guide" alt="" class="w-full h-full object-cover">
						</div>
						<p class="font-display font-semibold text-ink-900 mt-4 text-[15px] leading-snug">What NDIS Worker Screening Actually Checks</p>
						<p class="text-ink-400 text-[13px] mt-2">By NearCare · Apr 19, 2026</p>
					</a>
				</div>
			</div>

		</div>
	</section>
</Base>
